# WhatsApp Cloud API credentials
# Copy this file to .env and fill in real values — never commit .env to source control

# Your Meta App Secret (used for HMAC-SHA256 signature verification)
WHATSAPP_APP_SECRET=your_app_secret_here

# Token you set in the Meta developer portal when registering the webhook
WHATSAPP_VERIFY_TOKEN=your_verify_token_here

# Your WhatsApp Business phone number ID (from Meta dashboard)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Your long-lived or temporary access token for the WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=your_access_token_here

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# App environment: development | production
APP_ENV=development
